      "webhookId": "5b0c1f7e-1d2a-4c55-9f0e-6a1b2c3d4e5f"
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "c1",
              "name": "geminiApiKey",
              "value": "PASTE_GEMINI_API_KEY",
              "type": "string"
            },
            {
              "id": "c2",
              "name": "geminiUrl",
              "value": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent",
              "type": "string"
            },
            {
              "id": "c3",
              "name": "telegramBotToken",
              "value": "PASTE_TELEGRAM_BOT_TOKEN",
              "type": "string"
            },
            {
              "id": "c4",
              "name": "telegramChatId",
              "value": "PASTE_YOUR_CHAT_ID",
              "type": "string"
            },
            {
              "id": "c5",
              "name": "telegramApiBase",
              "value": "https://api.telegram.org",
              "type": "string"
            },
            {
              "id": "c6",
              "name": "hotThreshold",
              "value": 7,
              "type": "number"
            },
            {
              "id": "c7",
              "name": "companyDescription",
              "value": "Мы внедряем ИИ-агентов и автоматизацию бизнес-процессов (n8n, чат-боты, лидогенерация) для малого и среднего бизнеса.",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Нормализуем заявку с сайта и собираем запрос к Gemini\nconst cfg = $('Config').first().json;\nconst body = $('Webhook').first().json.body || {};\n\nconst lead = {\n  name: String(body.name || '').trim(),\n  email: String(body.email || '').trim().toLowerCase(),\n  company: String(body.company || '').trim(),\n  budget: String(body.budget || '').trim(),\n  message: String(body.message || '').trim().slice(0, 3000),\n  received_at: new Date().toISOString(),\n};\n\nif (!lead.message && !lead.email) {\n  throw new Error('Пустая заявка: нужен хотя бы email или текст сообщения');\n}\n\nconst prompt = `Ты — менеджер по продажам. Наша компания: ${cfg.companyDescription}\nОцени входящую заявку и верни ТОЛЬКО JSON вида:\n{\"score\": число 1-10 (насколько это горячий и подходящий нам клиент),\n \"segment\": \"одно-два слова: ниша клиента\",\n \"summary\": \"суть запроса в 1 предложении\",\n \"reply\": \"короткий вежливый ответ клиенту от нашего имени, 2-4 предложения, на языке заявки\"}\n\nЗаявка:\nИмя: ${lead.name}\nКомпания: ${lead.company}\nБюджет: ${lead.budget || 'не указан'}\nСообщение: ${lead.message}`;\n\nreturn [{\n  json: {\n    lead,\n    geminiRequest: {\n      contents: [{ role: 'user', parts: [{ text: prompt }] }],\n      generationConfig: { temperature: 0.2, responseMimeType: 'application/json' },\n    },\n  },\n}];"
      },
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Normalize lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.geminiUrl }}",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "key",
              "value": "={{ $('Config').first().json.geminiApiKey }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.geminiRequest) }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "Gemini: qualify lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "// Разбираем ответ модели; при ошибке не роняем поток, а помечаем заявку\nconst cfg = $('Config').first().json;\nconst lead = $('Normalize lead').first().json.lead;\nconst parts = $json.candidates?.[0]?.content?.parts || [];\nconst raw = parts.map(p => p.text || '').join('').replace(/```json|```/g, '').trim();\n\nlet ai;\ntry {\n  ai = JSON.parse(raw);\n} catch (e) {\n  ai = { score: 0, segment: 'unknown', summary: 'AI response parse error', reply: '' };\n}\n\nconst score = Math.max(0, Math.min(10, Number(ai.score) || 0));\nreturn [{\n  json: {\n    ...lead,\n    score,\n    segment: ai.segment || '',\n    summary: ai.summary || '',\n    reply_draft: ai.reply || '',\n    hot: score >= Number(cfg.hotThreshold),\n  },\n}];"
      },
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "Parse AI response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "f1",
              "leftValue": "={{ $json.hot }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "Hot lead?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.telegramApiBase }}/bot{{ $('Config').first().json.telegramBotToken }}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $('Config').first().json.telegramChatId, text: '🔥 Горячий лид (' + $json.score + '/10)\\n' + $json.name + ' — ' + $json.company + '\\n' + $json.email + '\\nБюджет: ' + ($json.budget || '—') + '\\n\\n' + $json.summary + '\\n\\nЧерновик ответа:\\n' + $json.reply_draft }) }}",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000007",
      "name": "Telegram: notify sales",
      "type": "n8n-nodes-base.httpRequest",
